# Harness config, written by hand.

# The web server.
- id: web # the main one
  name: server.http
  config:
    host: 0.0.0.0
    port: !expr env.PORT ?? 3080
    banner: |
      hello
      world
    tags: [a, b]

# The watcher.
- id: watch
  name: util.watch
  config:
    paths:
      - src
      - docs

# end of entries
