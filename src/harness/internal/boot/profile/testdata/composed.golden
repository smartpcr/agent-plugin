# core
# required: session.store, agent.registry, agent.driver, tools.registry, agent.presets
[
  {
    "id": "logging",
    "name": "boot.logging",
    "config": {
      "destination": "stderr",
      "level": "info"
    }
  },
  {
    "id": "sharing",
    "name": "host.sharing",
    "config": {
      "off": false
    }
  },
  {
    "id": "egress",
    "name": "util.egress"
  }
]
