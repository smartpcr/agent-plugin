    if: github.event_name == 'workflow_dispatch' && inputs.stage == 'DH-S-17'
    # M2-EN-8: no hosted runner; without an online runner carrying these labels the
    # job is never scheduled and S17 stays "not run" (M2-R-01).
    runs-on: [self-hosted, linux, dsh-e1, dsh-signed-in-claude, dsh-signed-in-copilot]
    timeout-minutes: 120
    defaults:
      run:
        shell: bash
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: src/harness/go.mod
          cache-dependency-path: |
            src/harness/go.sum
            tools/harness-gate/go.sum
      - name: Entry
        run: GOWORK=off go -C tools/harness-gate run . entry --root ../..
      - name: Signed-in route preflight (claude-code, required)
        env:
          DSH_REQUIRE_SCENARIOS: ""
        run: |
          set -o pipefail
          mkdir -p artifacts/harness
          GOWORK=off go -C src/harness build -o "$RUNNER_TEMP/dsh" ./cmd/dsh
          sha256sum "$RUNNER_TEMP/dsh" | tee artifacts/harness/s17-dsh.sha256
          echo "DSH_BIN=$RUNNER_TEMP/dsh" >> "$GITHUB_ENV"
          claude --version | tee artifacts/harness/s17-clients.txt
          DSH_BIN="$RUNNER_TEMP/dsh" GOWORK=off go -C src/harness test -tags scenario -count=1 -v -run '^TestSignedInRoutePreflight$/^claude-code$' ./internal/testkit/scenarios/ 2>&1 | tee artifacts/harness/s17-preflight-claude-code.txt
      - name: Signed-in route preflight (copilot-cli, recorded)
        env:
          DSH_REQUIRE_SCENARIOS: ""
        run: |
          set -o pipefail
          log=artifacts/harness/s17-preflight-copilot-cli.txt
          copilot --version | tee -a artifacts/harness/s17-clients.txt || true
          if GOWORK=off go -C src/harness test -tags scenario -count=1 -v -run '^TestSignedInRoutePreflight$/^copilot-cli$' ./internal/testkit/scenarios/ 2>&1 | tee "$log"; then
            result=passed
          else
            result="failed (route preflight)"
          fi
          echo "copilot-cli route preflight: $result" | tee -a "$log"
      - name: Derive the required scenarios from the DH-S-17 index entry
        run: |
          list="$(GOWORK=off go -C tools/harness-gate run . require --root ../.. --stage DH-S-17)"
          echo "stage=DH-S-17 DSH_REQUIRE_SCENARIOS=$list"
          echo "DSH_REQUIRE_SCENARIOS=$list" >> "$GITHUB_ENV"
      - name: Preflight
        id: preflight
        run: |
          GOWORK=off go -C tools/harness-gate run . preflight --root ../..
          count="$(sed -n 's/^count=//p' "$GITHUB_OUTPUT" | tail -n 1)"
          [ "$count" = 14 ] || { echo "DH-S-17 plans $count scenarios, want all 14 (M2-DEC-3)"; exit 1; }
      - name: Run the DH-S-17 scenarios (TOOLCHAIN-1 first, SANDBOX-7 last)
        # harness-gate scenarios runs the plan in order inside its 100 min budget:
        # per phase a required go test of the claude-code legs (DSH_SCENARIO_ROUTES),
        # which decides, then a recorded go test of the copilot-cli legs, whose result
        # is written to the record and never fails the stage (M2-DEC-4).
        env:
          DSH_SCENARIO_REPORT: ${{ github.workspace }}/artifacts/harness/s17-report.txt
        run: GOWORK=off go -C tools/harness-gate run . scenarios --root ../.. --stage DH-S-17 --evidence "../../artifacts/harness/s17-$GITHUB_SHA.txt"
      - name: Upload S17 evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: harness-s17
          path: artifacts/harness/
          if-no-files-found: warn
